# Base URL of the backend API (no trailing slash, no /api suffix — lib/api.ts adds it).
# Local backend: http://localhost:3000
# Deployed backend: https://home-recipes-back.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Auth.js (next-auth) — used only for the Google OAuth handshake (no adapter,
# no Auth.js-managed session; the app's own AuthContext/accessToken stays the
# source of truth). Set NEXTAUTH_URL to this app's own origin (local:
# http://localhost:3000, prod: the deployed Vercel URL). Generate
# NEXTAUTH_SECRET with `openssl rand -base64 32` (use a different one per
# environment).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth 2.0 Web application client — must be the SAME client as
# home-recipes_back's GOOGLE_CLIENT_ID (the ID token's `aud` claim has to
# match what the backend verifies against). Get CLIENT_SECRET from
# https://console.cloud.google.com/apis/credentials for that client, and add
# {NEXTAUTH_URL}/api/auth/callback/google as an authorized redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
